    "dejavu-fonts-ttf": "^2.37.3",
    "drizzle-orm": "1.0.0-beta.22",
    "exceljs": "^4.4.0",
    "frappe-gantt": "^1.2.2",
    "hono": "^4.13.9",
    "i18next": "^26.4.2",
    "jose": "^6.2.12",
    "mantine-react-table": "^2.0.0-beta.9",
    "otplib": "^13.5.0",
    "pdfjs-dist": "^6.3.289",
