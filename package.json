{
  "name": "envcheck-pmo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "build": "tsc -p app && vite build --config app/vite.config.ts",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p app && tsc -p netlify/functions",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "netlify database migrations apply",
    "db:seed-permissions": "tsx scripts/generate-permissions-seed.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "deps:check-age": "node scripts/check-lock-age.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@netlify/database-dev": "^1.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "1.0.0-beta.22",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
