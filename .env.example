# Sekrety — w Netlify ustaw jako zmienne środowiskowe oznaczone „Contains secret values”, scope: Functions.
# Lokalnie skopiuj do .env (plik ignorowany przez git) i uzupełnij.

# HS256 dla cookie pmo_mfa (min. 32 losowe bajty): openssl rand -base64 48
MFA_JWT_SECRET=
# Klucze AES-256-GCM pól szyfrowanych: "<keyId>:<base64 32B>[,<starszy keyId>:<base64>]"; pierwszy = aktywny.
# openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# HMAC-SHA256 do wyszukiwania po polach szyfrowanych (E3): openssl rand -base64 32
FIELD_HMAC_KEY=
# E-mail pierwszego Administratora (tworzony przy pierwszym logowaniu, gdy w bazie nie ma Admina)
BOOTSTRAP_ADMIN_EMAIL=

# Tylko lokalnie: logowanie deweloperskie pod netlify dev (Identity nie działa lokalnie). Nigdy w Netlify UI.
# DEV_AUTH=1

# Envcheck Hub (R4–R5): Claude API — https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=
# Tylko lokalnie: atrapa AI (deterministyczne odpowiedzi, bez kosztów) pod netlify dev — ma pierwszeństwo przed kluczem. Nigdy w Netlify UI.
# DEV_FAKE_AI=1
# Konto serwisowe Google (Drive + Docs) — client_email i private_key z pliku JSON (docs/DEPLOYMENT.md)
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# Faktury kosztowe: klucz API inFakt z uprawnieniem api:costs:read (app.infakt.pl → Ustawienia → Inne opcje → API)
INFAKT_API_KEY=
# Tylko lokalnie: atrapa inFakt (przykładowe koszty) pod netlify dev — ma pierwszeństwo przed kluczem. Nigdy w Netlify UI.
# DEV_FAKE_INFAKT=1
# Tylko lokalnie: atrapa Drive w pamięci pod netlify dev (bez Google). Nigdy w Netlify UI.
# DEV_FAKE_DRIVE=1
